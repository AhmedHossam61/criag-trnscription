# Copy to .env (never committed) and fill in.

# Gemini keys from https://aistudio.google.com/apikey -- used by `scribe correct`
# and by the archive's answers. Extra keys take over when one runs out of its
# daily free quota.
GEMINI_API=
GEMINI_API_2=

